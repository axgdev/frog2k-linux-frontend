+/*
+ * RAM code is often installed repeatedly by games.  Keep immutable translated
+ * bodies and exact source snapshots so a later incarnation can reuse the body.
+ * Every external edge into RAM is emitted as a lookup trampoline below; hence
+ * clearing an active tag makes an old body unreachable without rewriting it.
+ */
+#define RAM_VERSION_MAX 1024
+#define RAM_VERSION_BUCKETS 512
+#define RAM_VERSION_SOURCE_BYTES (512 * 1024)
+
+typedef struct
+{
+  u32 pc;
+  u32 body_offset;
+  u32 source_offset;
+  u16 source_length;
+  u16 tag_value;
+  u16 next;
+  u8 thumb;
+  u8 active;
+} ram_version_type;
+
+static ram_version_type ram_versions[RAM_VERSION_MAX];
+static u16 ram_version_buckets[RAM_VERSION_BUCKETS];
+static u8 ram_version_source[RAM_VERSION_SOURCE_BYTES];
+static u32 ram_version_count;
+static u32 ram_version_source_used;
+static bool ram_version_exhausted;
+static u32 ram_translation_store_pending;
+u32 ram_translation_version_hits;
+u32 ram_translation_version_invalidations;
+u32 ram_translation_version_resets;
+
+static inline bool translation_epoch_changed(u32 rom_epoch, u32 ram_epoch)
+{
+  return rom_cache_epoch != rom_epoch || ram_cache_epoch != ram_epoch;
+}
+
+static inline u8 *ram_source_pointer(u32 pc)
+{
+  return (pc >> 24) == 2 ? ewram + (pc & 0x3ffff)
+                         : iwram + 0x8000 + (pc & 0x7fff);
+}
+
+static inline u32 ram_source_limit(u32 pc)
+{
+  return (pc >> 24) == 2 ? 0x40000 : 0x8000;
+}
+
+static inline u32 ram_version_hash(u32 pc, bool thumb)
+{
+  return ((pc ^ (pc >> 9) ^ (thumb ? 0x9e3779b9U : 0)) *
+          2654435761U) & (RAM_VERSION_BUCKETS - 1);
+}
+
+static void ram_versions_reset(void)
+{
+  memset(ram_version_buckets, 0, sizeof(ram_version_buckets));
+  ram_version_count = 0;
+  ram_version_source_used = 0;
+  ram_version_exhausted = false;
+  ram_translation_version_resets++;
+}
+
+static ram_version_type *ram_version_find(u32 pc, bool thumb)
+{
+  u16 link = ram_version_buckets[ram_version_hash(pc, thumb)];
+
+  while (link) {
+    ram_version_type *version = &ram_versions[link - 1];
+    u32 offset = pc & (ram_source_limit(pc) - 1);
+    if (version->pc == pc && version->thumb == thumb &&
+        offset + version->source_length <= ram_source_limit(pc) &&
+        memcmp(ram_source_pointer(pc),
+               ram_version_source + version->source_offset,
+               version->source_length) == 0)
+      return version;
+    link = version->next;
+  }
+  return NULL;
+}
+
+static bool ram_version_add(u32 pc, u32 end, bool thumb, u8 *body)
+{
+  u32 length = end - pc;
+  u32 bucket;
+  ram_version_type *version;
+
+  if (!length || length > 0xffff ||
+      (pc & (ram_source_limit(pc) - 1)) + length > ram_source_limit(pc) ||
+      ram_version_count == RAM_VERSION_MAX ||
+      ram_version_source_used + length > RAM_VERSION_SOURCE_BYTES) {
+    ram_version_exhausted = true;
+    return false;
+  }
+
+  bucket = ram_version_hash(pc, thumb);
+  version = &ram_versions[ram_version_count];
+  version->pc = pc;
+  version->body_offset = (u32)(body - ram_translation_cache);
+  version->source_offset = ram_version_source_used;
+  version->source_length = (u16)length;
+  version->tag_value = 0;
+  version->next = ram_version_buckets[bucket];
+  version->thumb = thumb;
+  version->active = 0;
+  memcpy(ram_version_source + ram_version_source_used,
+         ram_source_pointer(pc), length);
+  ram_version_source_used += length;
+  ram_version_buckets[bucket] = (u16)(++ram_version_count);
+  return true;
+}
+
+static void ram_version_activate(ram_version_type *version, u16 tag_value)
+{
+  ramtag_type *tag = get_ram_tag(tag_value);
+  u32 *offset = version->thumb ? &tag->offset_thumb : &tag->offset_arm;
+  *offset = version->body_offset;
+  version->tag_value = tag_value;
+  version->active = 1;
+}
+
+static bool invalidate_ram_translation_store_internal(void *host_address,
+                                                       u32 size)
+{
+  uintptr_t host = (uintptr_t)host_address;
+  u32 region, write_start, write_end, i;
+  bool changed = false;
+
+  if (host >= (uintptr_t)ewram && host < (uintptr_t)ewram + 0x40000) {
+    region = 2;
+    write_start = (u32)(host - (uintptr_t)ewram);
+  } else if (host >= (uintptr_t)iwram + 0x8000 &&
+             host < (uintptr_t)iwram + 0x10000) {
+    region = 3;
+    write_start = (u32)(host - ((uintptr_t)iwram + 0x8000));
+  } else {
+    flush_translation_cache_ram_store_conservative();
+    return true;
+  }
+  write_end = write_start + size;
+  ram_translation_store_flush_count++;
+
+  for (i = 0; i < ram_version_count; i++) {
+    ram_version_type *version = &ram_versions[i];
+    u32 start, end;
+    ramtag_type *tag;
+    u32 *offset;
+    if (!version->active || (version->pc >> 24) != region)
+      continue;
+    start = version->pc & (ram_source_limit(version->pc) - 1);
+    end = start + version->source_length;
+    if (write_start >= end || write_end <= start)
+      continue;
+    tag = get_ram_tag(version->tag_value);
+    offset = version->thumb ? &tag->offset_thumb : &tag->offset_arm;
+    if (*offset == version->body_offset)
+      *offset = 0;
+    version->active = 0;
+    ram_translation_version_invalidations++;
+    changed = true;
+  }
+  return changed;
+}
+
+void invalidate_ram_translation_store(void *host_address, u32 size)
+{
+  /* Ordinary SMC stores redispatch immediately through smc_write; do not
+   * leak a deferred block-transfer decision into the next translated block. */
+  ram_translation_store_pending = 0;
+  (void)invalidate_ram_translation_store_internal(host_address, size);
+  ram_translation_store_pending = 0;
+}
+
+void block_store_invalidate_host(void *host_address, u32 size)
+{
+  u32 invalidations = ram_translation_version_invalidations;
+  if (invalidate_ram_translation_store_internal(host_address, size) ||
+      ram_translation_version_invalidations != invalidations)
+    ram_translation_store_pending = 1;
+}
+
+/* Guest-address entry point used by the MIPS SMC trampoline.  Keep the
+ * address-to-host conversion in one place so mirrored E/IWRAM stores use the
+ * same overlap checks as ordinary C-side stores. */
+void block_store_invalidate_guest(u32 address, u32 size)
+{
+  u32 offset;
+  u32 limit;
+  u8 *host;
+
+  if ((address >> 24) == 2) {
+    offset = address & 0x3ffff;
+    limit = 0x40000;
+    host = ewram + offset;
+  } else if ((address >> 24) == 3) {
+    offset = address & 0x7fff;
+    limit = 0x8000;
+    host = iwram + 0x8000 + offset;
+  } else {
+    /*
+     * Only EWRAM and IWRAM can back RAM translations.  Block stores to
+     * VRAM, MMIO, save memory, or unmapped regions cannot stale this arena
+     * and must not force a mid-block redispatch.
+     */
+    return;
+  }
+
+  /* A guest store wraps at the region boundary; avoid a partial overlap
+   * decision and retire the arena conservatively for such a transaction. */
+  if (size > limit || offset + size > limit) {
+    ram_translation_store_pending = 1;
+    flush_translation_cache_ram_store_conservative();
+    return;
+  }
+  block_store_invalidate_host(host, size);
+}
+
+u32 consume_ram_block_store_pending(void)
+{
+  u32 pending = ram_translation_store_pending;
+  ram_translation_store_pending = 0;
+  return pending;
+}
