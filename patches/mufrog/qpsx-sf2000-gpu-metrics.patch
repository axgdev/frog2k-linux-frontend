 #undef TN
 #undef TIBLOCK
 #undef POLY_CANONICAL_FLAGS
+
+///////////////////////////////////////////////////////////////////////////////
+// Optional renderer-driver histogram.  The production build leaves these
+// wrappers as the original direct table accesses, so there is no counter or
+// branch in the hot path.  A diagnostic build can enable the histogram to
+// identify the small set of inner-loop variants that account for most of the
+// work on a particular game/scene.  Keeping the counters here makes them
+// local to the translation unit that owns the renderer and avoids a data
+// relocation on the NOMMU target.
+#ifndef QPSX_GPU_RUNTIME_METRICS
+#define QPSX_GPU_RUNTIME_METRICS 0
+#endif
+
+#if QPSX_GPU_RUNTIME_METRICS
+static u32 qpsx_gpu_poly_hist[2048];
+static u32 qpsx_gpu_sprite_hist[256];
+static u32 qpsx_gpu_pixel_hist[64];
+static u32 qpsx_gpu_tile_hist[32];
+
+static inline PP qpsx_gpu_poly_driver(u32 index)
+{
+	++qpsx_gpu_poly_hist[index];
+	return gpuPolySpanDrivers[index];
+}
+
+static inline PS qpsx_gpu_sprite_driver(u32 index)
+{
+	++qpsx_gpu_sprite_hist[index];
+	return gpuSpriteSpanDrivers[index];
+}
+
+static inline PSD qpsx_gpu_pixel_driver(u32 index)
+{
+	++qpsx_gpu_pixel_hist[index];
+	return gpuPixelSpanDrivers[index];
+}
+
+static inline PT qpsx_gpu_tile_driver(u32 index)
+{
+	++qpsx_gpu_tile_hist[index];
+	return gpuTileSpanDrivers[index];
+}
+
+#define QPSX_GPU_POLY_DRIVER(index) qpsx_gpu_poly_driver((u32)(index))
+#define QPSX_GPU_SPRITE_DRIVER(index) qpsx_gpu_sprite_driver((u32)(index))
+#define QPSX_GPU_PIXEL_DRIVER(index) qpsx_gpu_pixel_driver((u32)(index))
+#define QPSX_GPU_TILE_DRIVER(index) qpsx_gpu_tile_driver((u32)(index))
+#else
+#define QPSX_GPU_POLY_DRIVER(index) gpuPolySpanDrivers[(index)]
+#define QPSX_GPU_SPRITE_DRIVER(index) gpuSpriteSpanDrivers[(index)]
+#define QPSX_GPU_PIXEL_DRIVER(index) gpuPixelSpanDrivers[(index)]
+#define QPSX_GPU_TILE_DRIVER(index) gpuTileSpanDrivers[(index)]
+#endif
--- a/src/gpu/gpu_unai/gpulib_if.cpp
+++ b/src/gpu/gpu_unai/gpulib_if.cpp
@@ -63,10 +63,71 @@
 
 /////////////////////////////////////////////////////////////////////////////
 
+#if QPSX_GPU_RUNTIME_METRICS
+/* Keep this report outside the primitive path.  The counters are bumped once
+ * per driver selection (never once per pixel), so a diagnostic build remains
+ * representative on the small HC15xx CPU. */
+static void qpsx_gpu_log_hist(const char *name, const u32 *hist, unsigned count)
+{
+  u32 total = 0;
+  unsigned nonzero = 0;
+  u32 top_count[4] = { 0, 0, 0, 0 };
+  unsigned top_index[4] = { 0, 0, 0, 0 };
+
+  for (unsigned i = 0; i < count; ++i) {
+    const u32 value = hist[i];
+    total += value;
+    if (value != 0) {
+      ++nonzero;
+      for (unsigned slot = 0; slot < 4; ++slot) {
+        if (value > top_count[slot]) {
+          for (unsigned move = 3; move > slot; --move) {
+            top_count[move] = top_count[move - 1];
+            top_index[move] = top_index[move - 1];
+          }
+          top_count[slot] = value;
+          top_index[slot] = i;
+          break;
+        }
+      }
+    }
+  }
+
+  GPUIF_LOG("GPU driver metrics %s total=%u nonzero=%u "
+            "top=%u:%u,%u:%u,%u:%u,%u:%u", name, total, nonzero,
+            top_index[0], top_count[0], top_index[1], top_count[1],
+            top_index[2], top_count[2], top_index[3], top_count[3]);
+}
+
+static void qpsx_gpu_log_metrics(void)
+{
+  qpsx_gpu_log_hist("poly", qpsx_gpu_poly_hist,
+                    sizeof(qpsx_gpu_poly_hist) / sizeof(qpsx_gpu_poly_hist[0]));
+  qpsx_gpu_log_hist("sprite", qpsx_gpu_sprite_hist,
+                    sizeof(qpsx_gpu_sprite_hist) / sizeof(qpsx_gpu_sprite_hist[0]));
+  qpsx_gpu_log_hist("pixel", qpsx_gpu_pixel_hist,
+                    sizeof(qpsx_gpu_pixel_hist) / sizeof(qpsx_gpu_pixel_hist[0]));
+  qpsx_gpu_log_hist("tile", qpsx_gpu_tile_hist,
+                    sizeof(qpsx_gpu_tile_hist) / sizeof(qpsx_gpu_tile_hist[0]));
+}
+
+extern "C" void renderer_log_metrics(void)
+{
+  qpsx_gpu_log_metrics();
+}
+#endif
+
 int renderer_init(void)
 {
   GPUIF_LOG("renderer_init() start");
 
+#if QPSX_GPU_RUNTIME_METRICS
+  memset(qpsx_gpu_poly_hist, 0, sizeof(qpsx_gpu_poly_hist));
+  memset(qpsx_gpu_sprite_hist, 0, sizeof(qpsx_gpu_sprite_hist));
+  memset(qpsx_gpu_pixel_hist, 0, sizeof(qpsx_gpu_pixel_hist));
+  memset(qpsx_gpu_tile_hist, 0, sizeof(qpsx_gpu_tile_hist));
+#endif
+
   GPUIF_LOG("memset gpu_unai (%d bytes)...", (int)sizeof(gpu_unai));
   memset((void*)&gpu_unai, 0, sizeof(gpu_unai));
   GPUIF_LOG("memset done");
