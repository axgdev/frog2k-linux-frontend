@@ -52,6 +52,9 @@
 #ifndef QPSX_GPU_PACKED_SPRITE_4BPP
 #define QPSX_GPU_PACKED_SPRITE_4BPP 0
 #endif
+#ifndef QPSX_GPU_4BPP_FLATV
