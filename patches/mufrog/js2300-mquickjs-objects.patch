From: SF2000 Linux <sf2000@localhost>
Subject: [PATCH] js2300: build mqjs and mqjs_stdlib from the mquickjs tree

The upstream mquickjs split the standard library into mqjs.c and
mqjs_stdlib.c.  js2300_runtime.c's generated stdlib table references the
constructors defined there (js_date_constructor, js_math_min_max, ...), so
compile those sources into the library and generate the mqjs_stdlib.h header
they require, mirroring the mquickjs Makefile flow.  Both generator sources
define their own main(), so those are renamed with -Dmain=... to avoid
duplicate-symbol collisions when the objects are linked into the frontend.

--- a/Makefile
+++ b/Makefile
@@ -24,7 +24,9 @@
 	$(BUILD)/mquickjs.o \
 	$(BUILD)/dtoa.o \
 	$(BUILD)/libm.o \
-	$(BUILD)/cutils.o
+	$(BUILD)/cutils.o \
+	$(BUILD)/mqjs.o \
+	$(BUILD)/mqjs_stdlib.o
 
 .PHONY: all clean check
 
@@ -59,10 +61,20 @@
 	fi
 	@touch $@
 
+# Staged mquickjs sources are provided by the prepare-stamp recipe above.
+# A prerequisite-only pattern rule leaves the staged files unbuildable on a
+# fresh staging directory, so verify the prepare step really copied them.
+$(MQUICKJS_BUILD)/%: $(MQUICKJS_PREPARE_STAMP)
+	@test -f '$@'
+
 $(BUILD)/js2300_stdlib_gen.o: js2300_stdlib_gen.c $(MQUICKJS_PREPARE_STAMP) | $(BUILD)
 	@echo "  HOSTCC  $<"
 	@$(HOSTCC) $(HOST_CFLAGS) -o $@ -c $<
 
+$(MQUICKJS_BUILD)/%.host.o: $(MQUICKJS_PREPARE_STAMP)
+	@echo "  HOSTCC  $(MQUICKJS_BUILD)/$*.c"
+	@$(HOSTCC) $(HOST_CFLAGS) -o $@ -c $(MQUICKJS_BUILD)/$*.c
+
 $(BUILD)/mquickjs_build.host.o: $(MQUICKJS_PREPARE_STAMP) | $(BUILD)
 	@echo "  HOSTCC  $(MQUICKJS_BUILD)/mquickjs_build.c"
 	@$(HOSTCC) $(HOST_CFLAGS) -o $@ -c $(MQUICKJS_BUILD)/mquickjs_build.c
@@ -75,6 +84,14 @@
 	@echo "  GEN     $@"
 	@$< -m32 > $@
 
+
+$(MQUICKJS_BUILD)/mqjs_stdlib.h: $(MQUICKJS_BUILD)/mqjs_stdlib_gen
+	@echo "  GEN     $@"
+	@$< -m32 > $@
+
+$(MQUICKJS_BUILD)/mqjs_stdlib_gen: $(MQUICKJS_BUILD)/mqjs_stdlib.host.o $(MQUICKJS_BUILD)/mquickjs_build.host.o
+	@echo "  HOSTLD  $@"
+	@$(HOSTCC) -o $@ $^
 $(MQUICKJS_BUILD)/mquickjs_atom.h: $(BUILD)/js2300_stdlib_gen $(MQUICKJS_PREPARE_STAMP)
 	@echo "  GEN     $@"
 	@$< -a -m32 > $@
@@ -88,6 +105,14 @@
 	@echo "  CC      $(MQUICKJS_BUILD)/mquickjs.c"
 	@$(CC) $(CFLAGS) -MD -MP -c $(MQUICKJS_BUILD)/mquickjs.c -o $@
 
+
+$(BUILD)/mqjs.o: $(MQUICKJS_BUILD)/mqjs_stdlib.h $(MQUICKJS_BUILD)/mquickjs_atom.h | $(BUILD)
+	@echo "  CC      $(MQUICKJS_BUILD)/mqjs.c"
+	@$(CC) $(CFLAGS) -Dmain=js2300_mqjs_main -MD -MP -c $(MQUICKJS_BUILD)/mqjs.c -o $@
+
+$(BUILD)/mqjs_stdlib.o: $(MQUICKJS_PREPARE_STAMP) | $(BUILD)
+	@echo "  CC      $(MQUICKJS_BUILD)/mqjs_stdlib.c"
+	@$(CC) $(CFLAGS) -Dmain=js2300_mqjs_stdlib_main -MD -MP -c $(MQUICKJS_BUILD)/mqjs_stdlib.c -o $@
 $(BUILD)/dtoa.o: $(MQUICKJS_PREPARE_STAMP) | $(BUILD)
 	@echo "  CC      $(MQUICKJS_BUILD)/dtoa.c"
 	@$(CC) $(CFLAGS) -MD -MP -c $(MQUICKJS_BUILD)/dtoa.c -o $@
