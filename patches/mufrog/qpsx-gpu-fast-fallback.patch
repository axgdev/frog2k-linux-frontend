From: SF2000 Linux <sf2000@localhost>
Subject: [PATCH] qpsx: fold out unavailable r2 GPU choices on MIPS32r1

The SF2000 configuration aliases its assembly and fast-lighting menu bits, but
the MIPS32r1 build deliberately excludes the r2-only assembly helpers.  The
fallback macros already select the identical fast C math; report assembly as
unavailable at compile time as well.  This lets every generated pixel-span
specialization remove an otherwise redundant config load and branch before
the fast lighting/blending path.

--- a/src/gpu/gpu_unai/gpu_unai.h
+++ b/src/gpu/gpu_unai/gpu_unai.h
@@ -329,7 +329,9 @@ static inline bool FastBlendingEnabled()
  */
 static inline bool AsmLightingEnabled()
 {
-#if defined(SF2000) || defined(__mips__)
+#if defined(QPSX_DISABLE_MIPS32R2_GPU_ASM)
+	return false;
+#elif defined(SF2000) || defined(__mips__)
 	return gpu_unai.config.asm_lighting;
 #else
 	return false;  // Not available on non-MIPS
@@ -338,7 +340,9 @@ static inline bool AsmLightingEnabled()
 
 static inline bool AsmBlendingEnabled()
 {
-#if defined(SF2000) || defined(__mips__)
+#if defined(QPSX_DISABLE_MIPS32R2_GPU_ASM)
+	return false;
+#elif defined(SF2000) || defined(__mips__)
 	return gpu_unai.config.asm_blending;
 #else
 	return false;
