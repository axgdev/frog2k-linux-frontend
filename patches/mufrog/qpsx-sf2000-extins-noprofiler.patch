+        profiler_frame_start();
         psxCpu->Execute();
+        profiler_frame_end();
     } else {
         frame_throttle_acc += g_target_speed;
         if (frame_throttle_acc >= 100) {
             frame_throttle_acc -= 100;
             /* Emulate this frame */
+            profiler_frame_start();
